---
const links = [
  { href: "/#home", label: "Home" },
  { href: "/#projects", label: "Projects" },
  { href: "/#skills", label: "Skills" },
  { href: "/#contact", label: "Contact" },
];
---
<header class="fixed top-4 left-0 right-0 z-50">
  <nav class="mx-auto max-w-6xl flex items-center justify-between bg-black/80 backdrop-blur-md border border-white/10 rounded-2xl px-6 py-4">
    <a href="/" class="text-xl font-bold text-white">
      <em class="text-accent not-italic">My</em> Portfolio
    </a>
    <ul class="flex gap-2">
      {links.map((link) => (
        <li>
            <a
            href={link.href}
            class="px-4 py-2 rounded-full text-sm font-semibold text-gray-200 hover:text-white hover:bg-white/10 transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
