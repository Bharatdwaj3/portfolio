---
// src/components/Footer.astro
import FooterContactForm from "../islands/FooterContactForm";
import { fetchProfile } from "../util/api";
const profile = await fetchProfile();

const siteLinks = [
  { label: 'Projects', href: '/#projects' },
];

const connectLinks = [
  { label: 'GitHub', href: 'https://github.com/' },
  { label: 'LinkedIn', href: 'https://linkedin.com/' },
  { label: 'Contact', href: '/#contact' },
];
---

<footer class="bg-black/60 pt-16 pb-8 px-6 text-white relative overflow-hidden">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-14">
      <div class="md:col-span-4">
        <a href="/" class="text-lg font-semibold mb-4 inline-block">
          <em class="text-accent not-italic">My</em> Portfolio
        </a>
        <p class="text-text-muted text-sm leading-relaxed max-w-xs mt-2">
          Projects, skills, and write-ups — pulled live and kept current.
        </p>
      </div>
      <div class="md:col-span-2">
        <h4 class="text-accent text-[11px] font-black uppercase tracking-[0.3em] mb-5">Site</h4>
        <ul class="space-y-3">
          {siteLinks.map((link) => (
            <li>
              <a href={link.href} class="text-text-muted hover:text-white text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-accent text-[11px] font-black uppercase tracking-[0.3em] mb-5">Connect</h4>
        <ul class="space-y-3">
          {connectLinks.map((link) => (
            <li>
              <a href={link.href} class="text-text-muted hover:text-white text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div id="contact" class="md:col-span-4">
        <h4 class="text-accent text-[11px] font-black uppercase tracking-[0.3em] mb-5">Let's Connect</h4>
        <p class="text-text-muted text-sm mb-4">Have a project in mind? Leave your email and I'll get back to you.</p>
        <FooterContactForm client:visible />
        {profile.resumeUrl && (
          <a href={profile.resumeUrl} target="_blank" rel="noreferrer" class="inline-block text-accent text-xs font-semibold mt-3 hover:underline">
            Download Resume →
          </a>
        )}
      </div>
    </div>

    <div class="flex justify-center md:justify-start gap-4 mb-8">
      <a href="https://github.com/" target="_blank" rel="noreferrer" class="text-text-muted hover:text-white transition-colors" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.13-.02-2.04-3.2.7-3.88-1.36-3.88-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .31.21.66.79.55A10.51 10.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/>
        </svg>
      </a>
      <a href="https://linkedin.com/" target="_blank" rel="noreferrer" class="text-text-muted hover:text-white transition-colors" aria-label="LinkedIn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
        </svg>
      </a>
    </div>

    <div class="pt-8 border-t border-white/10 text-[10px] font-bold uppercase tracking-widest text-text-faint text-center md:text-left">
      © 2026. Built with Astro.
    </div>
  </div>
</footer>
