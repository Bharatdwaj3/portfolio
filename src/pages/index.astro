---

import Layout from "../layouts/Layout.astro";
import ProjectsGrid from "../islands/ProjectsGrid";
import Reveal from "../islands/Reveal";
import { fetchProfile, fetchTestimonials, fetchProjects } from "../util/api";
import { fetchSkills } from "../util/api";
import { skillIconSlug } from "../util/skillCategories";

const profile = await fetchProfile();
const testimonials = await fetchTestimonials();
const skills = await fetchSkills();



---

<Layout title="My Portfolio">
  <main>
      <!-- Hero -->
      <section id="home" class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center px-6 overflow-hidden">
        <div
          class="absolute inset-0 -z-10"
          style="background: radial-gradient(circle at 50% 30%, hsl(330 45% 14%), var(--color-bg) 70%);"
        ></div>
        <Reveal client:visible>
        <div class="max-w-2xl mx-auto text-center">
          <div class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-md border border-white/20 rounded-full px-4 py-1.5 text-xs text-gray-200 mb-8">
            <span class="bg-white text-gray-900 font-semibold px-2 py-0.5 rounded-full text-[10px]">Open</span>
            <span>Available for Freelance Work</span>
          </div>
          <h1 class="font-extrabold mb-3 leading-tight tracking-tight" style="font-size: clamp(2.75rem, 6vw, 4.5rem);">
            {profile.fullName}
          </h1>
          <h5 class="text-accent font-semibold mb-6 text-lg">
            {profile.headline}
          </h5>
          <p class="text-gray-200 text-left max-w-xl mx-auto mb-8 leading-relaxed">{profile.bio}</p>
          <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="#projects" class="inline-flex items-center gap-2 bg-accent text-black hover:opacity-90 px-8 py-3.5 rounded-full text-sm font-semibold transition-all">
              View Work
            </a>
            <a href="#contact" class="border border-white/40 text-white rounded-full px-8 py-3.5 text-sm hover:bg-white hover:text-gray-900 transition-colors">
              Hire Me
            </a>
          </div>
        </div>
        </Reveal>
      </section>

    <section id="projects" class="relative py-24 px-6 bg-surface overflow-hidden">
      <div class="absolute left-1/2 top-0 -translate-x-1/2 w-[600px] h-[600px] bg-accent/10 rounded-full blur-[120px] pointer-events-none"></div>
      <Reveal client:visible>
      <div class="relative max-w-6xl mx-auto">
        <ProjectsGrid client:load />
      </div>
      </Reveal>
    </section>
    
    {testimonials.length > 0 && (
      <section id="testimonials" class="py-24 px-6 bg-surface">
        <Reveal client:visible>
        <div class="max-w-6xl mx-auto">
          <h4 class="text-2xl font-bold mb-8">
            What Clients Say
          </h4>
          <div class="grid md:grid-cols-2 gap-6">
            {testimonials.map((testimonial) => (
              <div class="bg-panel rounded-2xl p-6">
                <p class="text-gray-300 mb-4">"{testimonial.quote}"</p>
                <h4 class="text-sm font-semibold">{testimonial.clientName}</h4>
                <span class="text-xs text-text-faint">{testimonial.clientRole}</span>
              </div>
            ))}
          </div>
        </div>
        </Reveal>
      </section>
    )}

  </main>
</Layout>
