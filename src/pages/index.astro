---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import ProjectsGrid from "../islands/ProjectsGrid";
import ContactForm from "../islands/ContactForm";
import Reveal from "../islands/Reveal";
import { fetchProfile, fetchTestimonials } from "../util/api";
import { fetchSkills } from "../util/api";

const profile = await fetchProfile();
const testimonials = await fetchTestimonials();
const skills = await fetchSkills();
---

<Layout title="My Portfolio">
  <main>
    <!-- Hero -->
    <section id="home" class="min-h-screen flex items-center px-6 bg-surface">
      <Reveal client:visible>
      <div class="max-w-4xl mx-auto text-center pt-20">
        <h5 class="text-accent font-medium mb-4 uppercase tracking-widest text-sm">
          {profile.headline}
        </h5>
        <h1 class="text-5xl md:text-6xl font-black mb-6">{profile.fullName}</h1>
        <p class="text-gray-400 max-w-2xl mx-auto mb-8 leading-relaxed">{profile.bio}</p>
        <div class="flex items-center justify-center gap-4">
          <a href="#projects" class="bg-accent text-black text-sm font-black uppercase tracking-widest px-6 py-3 rounded-full hover:opacity-90 transition-opacity">
            View Projects
          </a>
          {profile.resumeUrl && (
            
      <a
              href={profile.resumeUrl}
              target="_blank"
              rel="noreferrer"
              class="border border-accentDark text-accentDark rounded-full px-6 py-3 text-sm hover:bg-white hover:text-accent transition-colors"
            >
              Download Resume
            </a>
          )}
        </div>
      </div>
      </Reveal>
    </section>

    <!-- Projects -->
    <section id="projects" class="py-24 px-6 bg-panel">
      <Reveal client:visible>
      <div class="max-w-6xl mx-auto">
        <ProjectsGrid client:load />
      </div>
      </Reveal>
    </section>

    <!-- Skills -->
    <section id="skills" class="py-24 px-6 bg-surface">
      <Reveal client:visible>
      <div class="max-w-6xl mx-auto">
        <h4 class="text-2xl font-bold mb-8">
          <em class="text-accentDark not-italic">My</em> Skills
        </h4>
        <ul class="bg-panel rounded-2xl p-8 space-y-4">
          {skills.map((skill) => (
            <li class="flex justify-between border-b border-gray-700 pb-3 last:border-0">
              <span>{skill.name}</span>
              <span class="text-sm text-gray-400">
                {skill.category} · {skill.level}
                {skill.projectCount > 0 && ` · ${skill.projectCount} projects`}
              </span>
            </li>
          ))}
        </ul>
      </div>
      </Reveal>
    </section>

    <!-- About + Testimonials -->
    <section id="about" class="py-24 px-6 bg-panel">
      <Reveal client:visible>
      <div class="max-w-6xl mx-auto">
        <div class="bg-surface rounded-2xl p-8 grid md:grid-cols-2 gap-8 items-center">
          <div>
            <h4 class="text-2xl font-bold mb-4">
              <em class="text-accentDark not-italic">About</em> Me
            </h4>
            <p class="text-gray-400">{profile.bio}</p>
          </div>
          <ul class="bg-panel rounded-2xl p-6 space-y-4">
            {profile.services.map((service) => (
              <li class="border-b border-gray-700 pb-3 last:border-0 last:pb-0">{service}</li>
            ))}
            {profile.links.map((link) => (
              <li class="border-b border-gray-700 pb-3 last:border-0 last:pb-0">
                <a href={link.url} target="_blank" rel="noreferrer" class="hover:text-accent">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        {testimonials.length > 0 && (
          <div class="mt-12 pt-8 border-t border-gray-700">
            <h4 class="text-2xl font-bold mb-6">
              <em class="text-accentDark not-italic">What</em> Clients Say
            </h4>
            <div class="grid md:grid-cols-2 gap-6">
              {testimonials.map((testimonial) => (
                <div class="bg-surface rounded-2xl p-6">
                  <p class="text-gray-300 mb-4">"{testimonial.quote}"</p>
                  <h4 class="text-sm font-semibold">{testimonial.clientName}</h4>
                  <span class="text-xs text-gray-500">{testimonial.clientRole}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
      </Reveal>
    </section>

    <!-- Contact -->
    <section id="contact" class="py-24 px-6 bg-surface">
      <Reveal client:visible>
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h4 class="text-2xl font-bold">
          <em class="text-accentDark not-italic">Get in</em> Touch
        </h4>
      </div>
      <ContactForm client:load />
      </Reveal>
    </section>
  </main>
</Layout>
